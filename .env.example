# Copy to .env (git-ignored) and fill in. NEVER commit .env.
GEMINI_API_KEY=paste-your-AI-Studio-key-here
# The ADK agent looks for this name: use the same key.
GOOGLE_API_KEY=paste-the-same-key-here

# Settings used in this project (code defaults live in src/rag/config.py)
JUDGE_MODEL=gemini-3.6-flash   # code default gemini-3.8-flash was often overloaded
HYBRID=1                       # hybrid (BM25 + RRF) retrieval, the chosen configuration; code default is 0

# Optional overrides
# GEN_MODEL=gemini-3.1-flash-lite
# EMBED_MODEL=gemini-embedding-2
# EMBED_DIM=768
# CHUNK_CHARS=1200
# CHUNK_OVERLAP=200
# TOP_K=5
